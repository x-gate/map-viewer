{
  "name": "map-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dev",
    "dev": "vite",
    "build:wasm": "bun scripts/build-wasm.ts",
    "build": "bun run lint && bun run typecheck && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests docs index.html vite.config.ts playwright.config.ts README.md package.json",
    "test": "bun test tests/unit",
    "test:e2e": "bun run scripts/create-fixture.ts && playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 8080"
  },
  "dependencies": {
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0"
  }
}
